#Deel 2
#voor het maken van een countmatrix gebruik je de code 
count_matrix <- featureCounts(
  files = "al1.BAM",
  annot.ext = "genomic.gtf",
  isPairedEnd = FALSE,
  isGTFAnnotationFile = TRUE, 
  GTF.featureType = "gene",
  GTF.attrType = "gene_id",
  useMetaFeatures = TRUE
)
# om alle smapels in de vector te zetten doe je 
allsampels <- c("control1.BAM", "control2.BAM", "control3.BAM", "control4.BAM", "al1.BAM", "al2.BAM", "al3.BAM", "al4.BAM")
#dan maak je een countmatrix van alle sampels 
count_matrix <- featureCounts(
  files = allsampels,
  annot.ext = "genomic.gtf",
  isPairedEnd = FALSE,
  isGTFAnnotationFile = TRUE,
  GTF.featureType = "gene", 
  GTF.attrType = "gene_id",
  useMetaFeatures = TRUE
)
#om te bekijken wat er in de countmatrix staat gebruik je 
str(count_matrix)
# nu wordt de funct count_matrix$counts opgeslagen onder de naam counts 
counts <- count_matrix$counts
#om de kolom namen van de countmatrix wat duidelijker te maken worden de namen aangepast 
colnames(counts) <- c("control1", "control2", "control3", "control4", "al1", "al2", "al3", "al4")
#om de countmatrix op te slaan genruik je de volgende code dit doe je zodat de countmatrix snel weer kan worden in geladen
write.csv(counts, "human_countmatrix.csv")
#deel 3
# voor het inladen van de countmatrix gebruik je de code 
counts <- read.csv("human_countmatrix.csv")
# nu worden er de volgende packages gedownload
BiocManager::install("DESeq2")
BiocManager::install("KEGGREST")
BiocManager::install("EnhancedVolcano")
BiocManager::install("pathview")
# daarna om te checken gebruik je library
library(DESeq2)
library(KEGGREST)
library(EnhancedVolcano)
library(pathview)
#nu wordt er een tabel gemaakt die beschrijft welke sampels controle zijn en welke niet 
treatment <- c("control", "control", "control", "control", "Rheumatoid arthritis", "Rheumatoid arthritis", "Rheumatoid arthritis", "Rheumatoid arthritis")
# dan vervolgens maak je de tabel door
treatment_table <- data.frame(treatment)
#om alles in de juiste statistische format te zetten doe je
dds <- DESeqDataSetFromMatrix(countData = counts,
                              colData = treatment_table,
                              design = ~ treatment)
#nu wordt de analyse uitgevoerd 
dds <- DESeq(dds)
resultaten <- results(dds)
#nu worden de resultaten opgeslagen 
write.table(resultaten, file = 'ResultatenCasus_RA.csv', row.names = TRUE, col.names = TRUE)
#om te kijken welke genen een verdubbeling hebben gebruik je de code 
sum(resultaten$padj < 0.05 & resultaten$log2FoldChange > 1, na.rm = TRUE)
#om te kunnen kijken naar welke genen een halvering hebben gebruik je de code 
sum(resultaten$padj < 0.05 & resultaten$log2FoldChange < -1, na.rm = TRUE)
#om te kijken welke genen er tussen uit srpingen gebruik je de volgende codes
hoogste_fold_change <- resultaten[order(resultaten$log2FoldChange, decreasing = TRUE), ]
laagste_fold_change <- resultaten[order(resultaten$log2FoldChange, decreasing = FALSE), ]
laagste_p_waarde <- resultaten[order(resultaten$padj, decreasing = FALSE), ]
# voor het maken van de volcano plot gebruik je de code 
EnhancedVolcano(resultaten,
                lab = rownames(resultaten),
                x = 'log2FoldChange',
                y = 'padj')
#om vervolgens de volconoplot op te slaan gebruik je de volgende code 
dev.copy(png, 'VolcanoplotWC.png', 
         width = 8,
         height = 10,
         units = 'in',
         res = 500)
dev.off()
